# Скопируйте в .env и заполните
# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=change-me
# Публичный адрес CRM (используется в коде трекера для сайтов клиентов)
PUBLIC_URL=https://crm.example.com
# Открыта ли самостоятельная регистрация новых компаний
ALLOW_SIGNUP=true
PORT=3000
# Ключ шифрования токенов соцсетей (если не задан — производный от JWT_SECRET; не меняйте после подключения каналов)
SECRETS_KEY=

# --- Оплата через ЮKassa (без ключей оплата выключена, лимитов нет) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки 54-ФЗ через ЮKassa; YOOKASSA_VAT_CODE: 1 = без НДС
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
# Реквизиты для счетов юрлицам
SELLER_NAME=
SELLER_INN=
SELLER_KPP=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_BIK=
SELLER_ACCOUNT=
SELLER_CORR_ACCOUNT=
# Владельцы платформы (раздел «Платформа»)
SUPERADMIN_EMAILS=

# --- Письма (без SMTP_URL письма только пишутся в лог) ---
# Пример для Яндекс 360: smtps://no-reply%40ваш-домен.ru:пароль-приложения@smtp.yandex.ru:465
SMTP_URL=
MAIL_FROM="Пульс CRM <no-reply@ваш-домен.ru>"
MAIL_REPLY_TO=
